# Copy this file to .env and fill in your own values: cp .env.example .env
# .env is gitignored, so your keys stay out of version control.

# --- The judge: Laya, the open-weight System-1 decision model ---
# Laya replaces the hosted Jev judge. `laya-serve` (installed with
# `pip install "laya[serve]"`) exposes the same /v1/systemone wire protocol
# that the TypeSafe SDK / DeepEval's JevEval speak, so the eval code is
# unchanged -- only this base URL differs.
#
# Start the judge first (CPU is fine; ~0.2-0.5s per decision):
#   .venv/Scripts/laya-serve        # http://localhost:8000
#
# Give the root only: the TypeSafe SDK appends /v1/systemone itself.
TYPESAFE_BASE_URL=http://localhost:8000
# laya-serve checks no key unless it was started with LAYA_API_KEY set, but the
# SDK refuses to start with an empty value -- any non-empty string works.
TYPESAFE_API_KEY=local-laya
# Names the laya checkpoint: "typed-decisions" (fine-tuned for judge-type
# questions, recommended), "english", "multilingual", or a Jev-style id such
# as "jev-1" which falls through to Laya's router.
TYPESAFE_MODEL_NAME=typed-decisions

# --- The agent under test (needed for the live-agent tests) ---
# AGENT_BACKEND=llm: any OpenAI-compatible endpoint. INFERENCE_API_STYLE picks
# the API shape: "responses" for OpenAI, "chat" for Ollama / LM Studio / vLLM
# and most other servers.
# AGENT_BACKEND=extractive: no LLM at all -- a deterministic stand-in that
# searches the knowledge base and quotes it, so the whole eval stack demos
# offline with zero API keys.
AGENT_BACKEND=extractive
INFERENCE_API_STYLE=chat
INFERENCE_BASE_URL=http://localhost:11434/v1
INFERENCE_API_KEY=ollama
INFERENCE_MODEL_NAME=llama3.2

# --- Golden generation (optional) ---
# The golden sets are already committed under goldens/, so this is only needed
# to regenerate them with DeepEval's Synthesizer (which uses OpenAI by default).
OPENAI_API_KEY=your-openai-api-key

# --- DeepEval settings ---
# 0 hides DeepEval's trace-posting notices, which otherwise clutter the
# agent's output. The agent's tracing is used by the structured layer.
CONFIDENT_TRACE_VERBOSE=0
# Folder where `deepeval test run` saves each run's results as JSON.
DEEPEVAL_RESULTS_FOLDER=./deepeval_results/
